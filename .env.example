# Copy this file to .env and customize for your environment.

# Do not commit real secrets to this file.

# --- Service discovery ---
REDIS_URL=redis://localhost:6379/0
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_interview_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Database SSL mode (disable, allow, prefer, require, verify-ca, verify-full).
# Managed PostgreSQL (e.g. Neon) requires DATABASE_SSLMODE=require
DATABASE_SSLMODE=require
DATABASE_SSLMODE=disable
DATABASE_URL=

# --- AI Provider Keys ---
OPENAI_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=
HF_TOKEN=
WHISPER_MODEL=base

# --- Worker / Celery ---
WORKER_CONCURRENCY=4
MAX_RETRIES=3
WORKER_ID=worker-1
WORKER_WEIGHT=
MAX_TASKS_BEFORE_RESTART=100
CELERY_POOL=solo
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
AUDIO_TEMP_DIR=/tmp
API_URL=http://fastapi:8000

# --- Data / Digest ---
DATA_DIR=./data
DIGEST_BATCH_SIZE=5

# --- Media / Service URLs ---
AUDIO_STREAM_URL=
VIDEO_STREAM_URL=
CV_SERVICE_URL=

# --- API / Security ---
API_TOKEN=CHANGE_ME
CORS_ALLOW_ORIGINS=*
RATE_LIMIT_PER_MINUTE=60

# --- Request validation ---
MAX_REQUEST_BODY_BYTES=1048576

# --- Audit logging ---
AUDIT_LOG_FILE=

# --- Monitoring ---
ENABLE_PROMETHEUS=true
GRAFANA_PASSWORD=change-me

# --- Logging ---
LOG_LEVEL=INFO
JSON_LOGGING=1

# --- Screen Lock ---
SCREEN_LOCK_TIMEOUT=300
SCREEN_LOCK_PIN=change-me
NEXT_PUBLIC_SCREEN_LOCK_PIN=change-me

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# --- Real-time Tracking ---
REALTIME_ENABLED=true
REALTIME_TICK_INTERVAL=1
MOMENT_TRACKING_ENABLED=true

# --- Authentication / JWT ---
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Anti-cheat Risk Scoring ---
# Pipeline weights should sum to 1.0.
RISK_VIDEO_WEIGHT=0.4
RISK_AUDIO_WEIGHT=0.3
RISK_EVALUATION_WEIGHT=0.3

# Risk classification thresholds
RISK_LOW_RISK_THRESHOLD=0.3
RISK_MEDIUM_RISK_THRESHOLD=0.6
RISK_HIGH_RISK_THRESHOLD=0.8

# Video signal factors
RISK_VIDEO_MULTIPLE_PERSONS=0.35
RISK_VIDEO_PHONE_DETECTED=0.25
RISK_VIDEO_SUSPICIOUS_HEAD=0.20
RISK_VIDEO_NO_FACE=0.45

# Audio signal factors
RISK_AUDIO_BACKGROUND_VOICES=0.35
RISK_AUDIO_SUSPICIOUS_PATTERN=0.25
RISK_AUDIO_NO_TRANSCRIPTION=0.40

# Evaluation signal factors
RISK_EVAL_LOW_QUALITY=0.30
RISK_EVAL_LOW_ACCURACY=0.40
RISK_EVAL_POOR_COMMUNICATION=0.20
RISK_EVAL_HALLUCINATION=0.30

# --- Application / AWS ---
ENVIRONMENT=development
AWS_SECRET_NAME=intelliview-secrets
AWS_REGION=us-east-1

# --- Email Notification (SMTP) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@intelliview.ai
SMTP_USE_TLS=false
APP_BASE_URL=http://localhost:8000

# --- Feature Flags ---
ENABLE_CELERY_BROKER=true
AUTO_SEED_DEMO_DATA=false
