 # Copy this file to .env and customize for your environment.
# --- Service discovery ---
REDIS_URL=redis://localhost:6379/0
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_interview_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_SSLMODE=disable
# --- AI Provider Keys ---
GEMINI_API_KEY=your_api_key_here
GROK_API_KEY=your-grok-api-key-here
# --- Worker / Celery ---
WORKER_CONCURRENCY=4
MAX_RETRIES=3
WORKER_ID=worker-1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
AUDIO_TEMP_DIR=/tmp
# --- API / Security ---
API_TOKEN=api123
CORS_ALLOW_ORIGINS=*
# --- Request validation ---
MAX_REQUEST_BODY_BYTES=1048576
# --- Audit logging ---
AUDIT_LOG_FILE=
# --- Monitoring ---
ENABLE_PROMETHEUS=true
GRAFANA_PASSWORD=admin
# --- Logging ---
LOG_LEVEL=INFO
JSON_LOGGING=1
# --- Screen Lock ---
# SCREEN_LOCK_TIMEOUT and SCREEN_LOCK_PIN are used server-side.
# NEXT_PUBLIC_SCREEN_LOCK_PIN must ALSO be set (Next.js only exposes
# NEXT_PUBLIC_-prefixed vars to browser code) - frontend/src/components/screenlock.jsx
# reads this one specifically; without it, the PIN silently falls back to "1234".
SCREEN_LOCK_TIMEOUT=300
SCREEN_LOCK_PIN=1234
NEXT_PUBLIC_SCREEN_LOCK_PIN=1234
# --- Real-time Tracking ---
REALTIME_ENABLED=true
REALTIME_TICK_INTERVAL=1
MOMENT_TRACKING_ENABLED=true
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# --- Anti-cheat Risk Scoring (workers/risk_engine.py) ---
# Pipeline weights - how much each analysis stream contributes to
# the final risk score. Should sum to 1.0.
RISK_VIDEO_WEIGHT=0.4
RISK_AUDIO_WEIGHT=0.3
RISK_EVALUATION_WEIGHT=0.3
# Risk classification thresholds (0-1 scale, increasing order)
RISK_LOW_RISK_THRESHOLD=0.3
RISK_MEDIUM_RISK_THRESHOLD=0.6
RISK_HIGH_RISK_THRESHOLD=0.8
# Video signal factors
RISK_VIDEO_MULTIPLE_PERSONS=0.35
RISK_VIDEO_PHONE_DETECTED=0.25
RISK_VIDEO_SUSPICIOUS_HEAD=0.20
RISK_VIDEO_NO_FACE=0.45
# Audio signal factors
RISK_AUDIO_BACKGROUND_VOICES=0.35
RISK_AUDIO_SUSPICIOUS_PATTERN=0.25
RISK_AUDIO_NO_TRANSCRIPTION=0.40
# Evaluation signal factors
RISK_EVAL_LOW_QUALITY=0.30
RISK_EVAL_LOW_ACCURACY=0.40
RISK_EVAL_POOR_COMMUNICATION=0.20
RISK_EVAL_HALLUCINATION=0.30